<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#D1BCFF</item>
        <item name="colorPrimaryDark">#46345E</item>
        <item name="colorAccent">#D1BCFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#30283C</item>
        <item name="android:navigationBarColor">#17131E</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#17131E</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
